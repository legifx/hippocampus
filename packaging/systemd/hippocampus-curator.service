[Unit]
Description=Hippocampus curator: the decision model behind brain.ask (unloads itself when idle)
Documentation=https://github.com/hippocampus-fm/hippocampus
# Not required by the daemon: without the curator, brain.ask answers in ranked order and says so.
After=hippocampus-cortexd.service

[Service]
Type=simple
ExecStart=%h/.local/bin/hippocampus-curator
Restart=on-failure
RestartSec=15
# The model is loaded on demand and dropped after HC_CURATOR_IDLE_SECS; this is the ceiling for
# the CPU case, where the weights live in RAM rather than on the card.
MemoryHigh=5G
MemoryMax=6G
Nice=5

[Install]
WantedBy=default.target
