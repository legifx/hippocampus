{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hippocampus",
  "version": "0.0.1",
  "identifier": "dev.hippocampus.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Hippocampus",
        "width": 900,
        "height": 560,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "center": true,
        "focus": true,
        "transparent": true,
        "decorations": false,
        "visible": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Search your filesystem by meaning",
    "longDescription": "The search overlay onto the Cortex memory daemon: a launcher that finds files by what they are about rather than by what they are called."
  }
}
