/target
**/*.rs.bk
Cargo.lock.orig

# Node / Tauri, from M4 onwards
node_modules/
ui/dist/
ui/src-tauri/target/

# Never commit models — they are fetched on first use and checksum-verified
*.onnx
*.gguf
*.safetensors

# Never commit an index or any local state
*.db
*.db-wal
*.db-shm
*.usearch

# Local environment
.env
.env.*
*.local.toml

# Playwright writes these on every run; they are output, not source.
ui/test-results/
ui/playwright-report/

# A snapshot of a real index contains real paths and is as sensitive as the index (D67).
# The demo that ships with the repository is generated by `brain-sim` from a seed.
ui-agent/dist-demo/
ui-agent/node_modules/
ui-agent/dist/
graph.json
