#!/usr/bin/env bash
#
# Repository hygiene gate — hard rule R9.
#
# This repository is public. Nothing that identifies one person's machine, network or accounts
# may enter it, and that includes commit history: removing a secret from a later commit does
# not remove it from the repo. This hook is the cheap moment to catch it.
#
# Install with scripts/setup-dev.sh, or copy to .git/hooks/pre-commit.
#
# `scripts/pre-commit --all` examines every tracked file instead of the staged ones. That is
# the CI gate M7 §4 asks for — "a grep of the public repository for endpoint patterns, private
# paths and credentials returns nothing" — and `crates/cortex-sync/tests/hygiene.rs` runs it
# under `cargo test`, so the gate is a test like every other gate in this repository.
#
# Deliberately conservative: a false positive costs one `git commit --no-verify` after a human
# has looked at it. A false negative costs a leaked credential forever.

set -uo pipefail

RED=$'\033[31m'; YELLOW=$'\033[33m'; RESET=$'\033[0m'
failed=0

# Only staged, non-deleted files are examined — or, with --all, every tracked file.
if [[ "${1:-}" == "--all" ]]; then
  mapfile -t files < <(git ls-files)
elif [[ "${1:-}" == "--history" ]]; then
  # M9 §3: the whole public history, every patch ever committed, through the same patterns.
  history_dump="$(mktemp)"
  trap 'rm -f "$history_dump"' EXIT
  git log -p --all --format='commit %H' > "$history_dump"
  files=("$history_dump")
else
  mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM)
fi
[[ ${#files[@]} -eq 0 ]] && exit 0

# Files that legitimately contain example-looking values.
is_exempt() {
  case "$1" in
    scripts/pre-commit) return 0 ;;
    docs/05-HARD-RULES.md) return 0 ;;   # documents the patterns it forbids
    *) return 1 ;;
  esac
}

report() {
  printf '%s%s%s\n  %s:%s\n' "$RED" "$1" "$RESET" "$2" "$3" >&2
  failed=1
}

for f in "${files[@]}"; do
  is_exempt "$f" && continue
  [[ -f "$f" ]] || continue
  # Skip anything that is not text.
  file --mime-encoding -b "$f" | grep -q binary && continue

  while IFS=: read -r line content; do
    [[ -z "${line:-}" ]] && continue
    report "private IPv4 address" "$f:$line" "$content"
  # Four octets, not three. `10.4.1` is a version number and `^10.6.0` is a dependency range;
  # a lock file is full of both, and flagging them trains people to ignore this gate.
  # Each alternative spells out its own remaining octets, so all three require a full address.
  # A single shared repeat count cannot: `10` needs three more octets, `192.168` needs two.
  done < <(grep -nE '(^|[^0-9.])(10(\.[0-9]{1,3}){3}|192\.168(\.[0-9]{1,3}){2}|172\.(1[6-9]|2[0-9]|3[01])(\.[0-9]{1,3}){2})([^0-9.]|$)' "$f" | head -5)

  while IFS=: read -r line content; do
    [[ -z "${line:-}" ]] && continue
    report "tailnet address" "$f:$line" "$content"
  done < <(grep -nE '\b100\.([6-9][0-9]|1[0-2][0-9])\.[0-9]{1,3}\.[0-9]{1,3}\b' "$f" | head -5)

  while IFS=: read -r line content; do
    [[ -z "${line:-}" ]] && continue
    report "private key material" "$f:$line" "$content"
  done < <(grep -nE 'BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE KEY' "$f" | head -5)

  while IFS=: read -r line content; do
    [[ -z "${line:-}" ]] && continue
    report "looks like a credential" "$f:$line" "$content"
  done < <(grep -nEi '(api[_-]?key|secret[_-]?key|access[_-]?token|bearer)[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_\-]{16,}' "$f" | head -5)

  while IFS=: read -r line content; do
    [[ -z "${line:-}" ]] && continue
    report "known provider token prefix" "$f:$line" "$content"
  done < <(grep -nE '\b(sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16})\b' "$f" | head -5)

  # An endpoint. A URL whose host is a real domain and not a public documentation, registry
  # or standards host is somebody's server, and the Core must not know one (M7 §4, D9).
  # A host without a dot (`nas`, `server`, `localhost`) is a placeholder, not an address.
  #
  # Deny-by-default over an allow-list, on purpose: the guarantee is "no unknown host", and a
  # rule that only looked at `peer =` assignments would miss a hostname in a comment or a test
  # string. The price is that every new documentation host has to be added here — which is what
  # happened with `debian.org` on 2026-09-05: the copyright-format URL in `packaging/deb/build.sh`
  # turned the gate red for a day, and the first review of that date recorded the suite as green
  # without re-running it. Widen the list; do not weaken the rule. A finding on a documentation
  # host is a finding about this list, and the fix is one entry below.
  while IFS=: read -r line content; do
    [[ -z "${line:-}" ]] && continue
    report "endpoint (a host the Core must not know)" "$f:$line" "$content"
  done < <(grep -noE '(https?|wss?|ssh|smb|sftp|nfs|ftp)://[A-Za-z0-9._-]+\.[A-Za-z0-9._-]+' "$f" \
             | grep -vE '://([a-z0-9-]+\.)*(github\.com|githubusercontent\.com|github\.io|npmjs\.org|npmjs\.com|crates\.io|docs\.rs|rust-lang\.org|huggingface\.co|opencollective\.com|tidelift\.com|w3\.org|whatwg\.org|json-schema\.org|tauri\.app|mozilla\.org|freedesktop\.org|sqlite\.org|ietf\.org|rfc-editor\.org|apache\.org|debian\.org|gnu\.org|kernel\.org|python\.org|nodejs\.org|spdx\.org|opensource\.org|creativecommons\.org|gnome\.org|gtk\.org|wikipedia\.org|wikimedia\.org|nvidia\.com|onnxruntime\.ai|example\.(com|org|net|invalid)|mydomain\.dev|asset\.localhost|127\.0\.0\.1)(:[0-9]+)?($|[^A-Za-z0-9._-])' \
             | head -5)

  # A home directory path from a real machine. Tests must build paths at runtime.
  while IFS=: read -r line content; do
    [[ -z "${line:-}" ]] && continue
    report "absolute home path from a private system" "$f:$line" "$content"
  done < <(grep -nE '/home/[a-z][a-z0-9_-]*/' "$f" | grep -vE '/home/(user|you|me|example|USERNAME|\$\{?USER)' | head -5)
done

if [[ $failed -ne 0 ]]; then
  cat >&2 <<'EOF'

Commit refused by the repository hygiene gate (hard rule R9).

This repository is public. If the finding above is a false positive, fix the finding rather
than the gate: use a placeholder (example.com, 198.51.100.1, /home/user/...) — or, when the
match is a public documentation, registry or standards host, add that host to the allow-list
in scripts/pre-commit and say so in the commit message.

Do not bypass this check with --no-verify. History is forever, and cargo test runs the same
scan over every tracked file and every patch in the history, so a bypass only moves the red
from your terminal to the test suite.
EOF
  exit 1
fi

printf '%shygiene gate: clean%s\n' "$YELLOW" "$RESET" >&2
exit 0
